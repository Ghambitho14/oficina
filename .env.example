# Copia estas variables en Coolify (pestaña Environment Variables) o en un archivo .env.

# --- Acceso al panel ---
ADMIN_USER=admin
# Genera el hash con: cd server && npm run hash-password -- "tu-contraseña"
ADMIN_PASSWORD_HASH=
# Cualquier texto largo y aleatorio, p. ej.: openssl rand -hex 32
SESSION_SECRET=

# --- Nombres (se ven en la interfaz y los usa la IA) ---
# Tu negocio. La app se llamará "Oficina <ORG_NAME>" salvo que pongas APP_NAME.
ORG_NAME=
# APP_NAME=
# Cómo se llama el servidor que vigilas (sale en la pantalla central de la oficina)
SERVER_NAME=VPS
# Con qué despliegas tus apps (opcional, la IA lo usa para dar consejos): Coolify, Dokploy, Docker Compose…
# SERVER_STACK=Coolify
# Qué hace tu negocio, si todavía no lo escribiste en el panel ("Sobre tu negocio")
# ORG_ABOUT=Hacemos páginas web y apps para pymes.

# --- Los agentes ---
# Nombre, personalidad, aspecto, modelo, qué alertas atiende cada uno, sus umbrales (CPU, puertos permitidos…),
# las páginas que se vigilan y su Telegram van en config/agentes.json. Copia server/agentes.example.json ahí y
# edítalo: se aplica solo, sin reiniciar. Otra ruta: AGENTS_FILE=/ruta/agentes.json
# Botón "Agentes de monitor" en una instalación nueva: on = arrancan encendidos (después manda el botón del panel).
# MONITOR_AGENTS=off
# Cada cuántos minutos revisan los agentes (solo en modo "intervalo")
AGENT_INTERVAL_MIN=5
# "alertas": los agentes esperan una alerta del monitor o una orden (por defecto si hay MONITOR_URL).
# "intervalo": revisan solos cada AGENT_INTERVAL_MIN (por defecto sin monitor).
# AGENT_MODE=
# Pon false si la Oficina NO corre en el servidor que vigila (por ejemplo, vive en tu homelab y lee al monitor
# del VPS por Tailscale). Así no confunde las métricas, el SSH y los puertos de su propia máquina con los del servidor.
# LOCAL_CHECKS=true

# --- container-monitor (opcional) ---
# URL del monitor que corre en el servidor (por Tailscale, p. ej. http://100.x.y.z:3000). Vacío = no se conecta.
MONITOR_URL=
# Cada cuántos segundos se le pregunta por alertas nuevas
# MONITOR_POLL_SEC=15
# Días que se guardan el registro de actividad y las métricas de las gráficas
# KEEP_DAYS=30

# --- SSH al servidor vigilado (opcional) ---
# Para que los agentes pidan más datos del servidor (y Leo revise SSH, puertos y actualizaciones aunque la Oficina
# viva en otra máquina). Solo pueden pedir consultas de SOLO LECTURA de una lista fija: en el servidor, el script
# scripts/oficina-ssh.sh decide qué se ejecuta (instrucciones dentro del script). Vacío = apagado.
# Leo además puede pedir Snort, firewall, todo sobre una IP, logs de contenedores y la base de datos; las que piden
# root las responde scripts/oficina-root.sh (con sudo, también de solo lectura). Cuando llega una alerta de Snort,
# Leo averigua solo quién es la IP. La IA (Claude o un modelo compatible con OpenAI) elige qué consultar.
# SSH_HOST=100.x.y.z
# SSH_USER=oficina
# SSH_PORT=22
# Con docker-compose: deja estas rutas y pon la llave en la carpeta SSH_DIR (se monta en /ssh, solo lectura).
# Carpeta del host con la llave privada (id_ed25519, dueño uid 1000, chmod 600) y known_hosts
# SSH_DIR=/home/usuario/.oficina-ssh
# SSH_KEY_FILE=/ssh/id_ed25519
# Huella del servidor (ssh-keyscan -H <host> > known_hosts). Si no está, se acepta la primera que vea.
# SSH_KNOWN_HOSTS=/ssh/known_hosts
# Consultas que la IA puede pedir por cada diagnóstico o pregunta del chat (0 = no deja a la IA consultar)
# SSH_AI_QUERIES=3

# --- Coolify (agente Tomás) ---
# En Coolify: Settings → API → actívala. Luego Keys & Tokens → API tokens → crea uno con permiso "read-only".
# COOLIFY_URL es la dirección de tu panel de Coolify (mejor con su dominio y HTTPS).
COOLIFY_URL=
COOLIFY_TOKEN=

# --- Supabase self-hosted (agente Valeria) ---
# La URL pública de Supabase (la de Kong) y la ANON key (es pública). NUNCA pongas la service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Variables viejas ---
# WATCH_URLS, ALLOWED_PORTS, ALERT_ROUTES, ALERT_DEFAULT_AGENT, AGENTS, CPU_WARN, RAM_WARN, DISK_WARN, SSL_WARN_DAYS,
# SSH_FAILS_WARN, SNORT_ALERTS_WARN, SLOW_MS, LOG_ERRORS_WARN y BACKUP_MAX_HOURS ahora van en config/agentes.json.
# Si siguen aquí, valen mientras el archivo no las traiga (al arrancar se avisa cuáles quedan).

# --- IA (opcional). Sin ningún proveedor, los agentes funcionan solo con reglas ---
# Puedes prender uno o varios; en config/agentes.json cada agente elige su "modelo" entre los que estén prendidos.
# Claude (Anthropic). Es el único que puede buscar clientes en la web.
ANTHROPIC_API_KEY=
# Ollama (modelos locales, gratis). La URL de tu Ollama; desde Docker, el host es host.docker.internal.
# Sus modelos se leen solos; para fijar la lista usa OLLAMA_MODELS (separados por coma).
# Ponle a Ollama OLLAMA_CONTEXT_LENGTH=8192 o más: los reportes no caben en el contexto chico que trae por defecto.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODELS=qwen3:8b,llama3.2
# OpenCode: tu API key de opencode.ai. Los modelos se leen solos o se fijan con OPENCODE_MODELS.
# OPENCODE_API_KEY=
# OPENCODE_MODELS=kimi-k2.6,glm-5.3
# Con la suscripción OpenCode Go: "go" (o go-plus). Usa la dirección y la lista de modelos de Go, y lo que cada
# respuesta descuenta del plan queda como gasto. Vacío = pago por uso con el saldo de la consola (ahí los modelos
# gratis no funcionan fuera de la app de OpenCode, así que no se ofrecen).
# OPENCODE_PLAN=go
# Cualquier API compatible con OpenAI: OpenAI, LM Studio (http://host.docker.internal:1234/v1), llama.cpp, vLLM, OpenRouter…
# Sin key se toma como local (gratis). OPENAI_NAME es cómo se ve en el panel.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODELS=
# OPENAI_NAME=LM Studio
# Modelos que "piensan" (qwen3.5…): "none" les pide responder directo, sin gastar los tokens razonando.
# Se manda como reasoning_effort; si el servidor no lo entiende, se pregunta sin él. También OLLAMA_REASONING y OPENCODE_REASONING.
# OPENAI_REASONING=none
# Precio por millón de tokens de OpenCode u OpenAI, solo para estimar el gasto (sin precio = $0)
# OPENCODE_PRICE_IN=0.5
# OPENCODE_PRICE_OUT=2
# Segundos máximos de espera por respuesta (los modelos locales pueden tardar)
# AI_TIMEOUT_SEC=300
# Key propia de un agente (opcional): AGENT_<ID>_API_KEY para Claude y AGENT_<ID>_<PROVEEDOR>_API_KEY para los demás
# (p. ej. AGENT_INSTAGRAM_OPENCODE_API_KEY). La tarjeta del agente en Ajustes › Agentes muestra el nombre exacto.
# AGENT_CIBERSEGURIDAD_API_KEY=
# Modelo general: uno de Claude (claude-haiku-5-5) o "proveedor:modelo" (ollama:qwen3:8b, opencode:kimi-k2.6, openai:gpt-5.4-mini).
# Los modelos locales no cuentan para AI_DAILY_TOKENS.
AI_MODEL=claude-haiku-5-5
# Tope de tokens en las últimas 24 h. Al llegar, los agentes siguen trabajando pero sin IA.
AI_DAILY_TOKENS=300000
# Buscador de clientes: modelo (siempre de Claude), búsquedas web por pedido y pedidos por día
# LEADS_MODEL=claude-haiku-5-5
# LEADS_MAX_SEARCHES=5
# LEADS_PER_DAY=5
# Oculta IPs, emails y tokens antes de enviar datos a la IA (true por defecto)
# AI_REDACT=true

# --- Obsidian: la memoria de los agentes (opcional) ---
# Ruta de tu bóveda DENTRO del contenedor. Con docker-compose: deja /vault y pon la ruta real en OBSIDIAN_HOST_DIR.
# Vacío = apagado.
# OBSIDIAN_DIR=/vault
# Ruta de la bóveda en el servidor (la carpeta que tiene .obsidian). El usuario del contenedor (uid 1000) debe poder escribir.
# OBSIDIAN_HOST_DIR=/home/usuario/obsidian/VPS
# Carpeta donde escriben los agentes (nunca tocan nada fuera de ella)
# OBSIDIAN_FOLDER=Oficina
# Tu nota principal: la nota central de la Oficina la enlaza
# OBSIDIAN_HOME_NOTE=00 Índice VPS
# Notas tuyas que los agentes leen como contexto antes de diagnosticar (nombres sin .md, separados por coma)
# OBSIDIAN_MEMORY_NOTES=Servidor,Seguridad - hallazgos
# Tope de caracteres de memoria por consulta a la IA (cuida los tokens)
# OBSIDIAN_MEMORY_CHARS=6000
# Zona horaria de las horas que se escriben en la bitácora
# TIMEZONE=America/Santiago

# --- Telegram (opcional) ---
# Cada alerta que investiga un agente llega con su nombre, fecha, hora, qué pasa y un color (🔴 🟡 🟢 🔵).
# Cada agente decide en agentes.json si manda y desde qué gravedad ("telegram": { "activo": true, "minimo": "ok" }).
# 1) Habla con @BotFather y crea un bot → te da el token
# 2) Escríbele algo a tu bot y abre https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
